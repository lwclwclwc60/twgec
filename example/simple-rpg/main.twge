#include "utils.twge"
#include "soundEffect.twge"
#include "load-store.twge"
#include "weapon.twge"
#include "monster.twge"
#include "skill.twge"
#include "map/map.twge"
#include "map/chunk.twge"
#include "dialog.twge"

block 點擊重置能力 {
    __repeat__ = -1;
    __label__ = "玩家";
    triggers {
        告示牌按鈕(varName = "instance", buttonId = "ResetPoint");
    }
    actions {
        儲存全域變數(key = "tmp_q", type = "int", value = "floor({instance.Level}/10)");
        儲存全域變數(key = "tmp_r", type = "int", value = "{instance.Level} - 10*{tmp_q}");
        自定義::儲存Instance整數("Point", "5 * {tmp_q} * ({tmp_q} + 3) + {tmp_r} * ({tmp_q} + 2)");
        自定義::儲存Instance整數("STR", 0);
        自定義::儲存Instance整數("CON", 0);
        自定義::儲存Instance整數("AGI", 0);
        自定義::儲存Instance整數("INT", 0);
        自定義::儲存Instance整數("PSY", 0);
        角色說話(actorId = "instance", text = "成功重設能力點，目前有{instance.Point}點能力點");
        自定義::更新角色屬性();
        自定義::上載Instance數據();
    }
}

block 等級提升 {
    __repeat__ = -1;
    __label__ = "玩家";
    checks {
        找出所有角色(actor = 角色::任何玩家, varname = "instance");
        比較數字(lhs = "{instance.Exp}", op = ">=", rhs = "{instance.ExpNeeded}");
    }
    actions {
        地圖標示文字(x = 公式::InstanceX坐標, y = 公式::InstanceY坐標, html = true, text = 文字::HTML等級提升, duration = 6000);
        自定義::儲存Instance整數("Exp", "{instance.Exp}-{instance.ExpNeeded}");
        自定義::儲存Instance整數("Point", "{instance.Point}+floor({instance.Level}/10)+2");
        自定義::儲存Instance整數("ExpNeeded", "({instance.Level}+10)*({instance.Level}+10)");
        自定義::儲存Instance整數("Level", "{instance.Level}+1");
        自定義::更新角色屬性();
        自定義::上載Instance數據();
    }
}

block 回血 {
    __repeat__ = -1;
    __repeatInterval__ = 10000;
    __label__ = "玩家";
    checks {
        找出所有角色(actor = 角色::任何玩家, varname = "instance");
    }
    actions {
        角色加減血(actorCode = "instance", value = 公式::Instance恢復量);
        自定義::儲存Instance整數("CurrentMP", "min({instance.MaxMP}, {instance.CurrentMP} + {instance.RegenMP})");
    }
}

block 玩家狀態更新 {
    __repeat__ = -1;
    __repeatInterval__ = 1000;
    __label__ = "玩家";
    checks {
        找出所有角色(actor = 角色::任何玩家, varname = "instance");
    }
    actions {
        let duration = 1010;
        EnhFF::廣義圓形範圍(defType = "rectangle", actorId = "instance",
            color = "#00ffee", duration = duration, lineWidth = 0,
            fill = true, fillColor = "#00ffee",
            offsetX = "-19*(1-{instance.CurrentMP}/{instance.MaxMP})", offsetY = -39, 
            width = "38*{instance.CurrentMP}/{instance.MaxMP}", height = 3);
        EnhFF::廣義圓形範圍(defType = "rectangle",actorId = "instance",
            color = "#000000", duration = duration, lineWidth = 0,
            fill = true, fillColor = "#000000", fillAlpha = "0.4",
            offsetX = "19*({instance.CurrentMP}/{instance.MaxMP})", offsetY = -39, 
            width = "38-38*{instance.CurrentMP}/{instance.MaxMP}", height = 3);
        EnhFF::廣義圓形範圍(defType = "rectangle",actorId = "instance",
            color = "#d7f9f1", duration = duration, lineWidth = 1,
            fill = true, fillColor = "#d7f9f1", fillAlpha = "1-{instance.skill{instance.ZSkill}CD}",
            offsetX = 25, offsetY = -40, width = 5, height = 5);
        EnhFF::廣義圓形範圍(defType = "rectangle",actorId = "instance",
            color = "#d7dff9", duration = duration, lineWidth = 1,
            fill = true, fillColor = "#d7dff9", fillAlpha = "1-{instance.skill{instance.XSkill}CD}",
            offsetX = 30, offsetY = -40, width = 5, height = 5);
        EnhFF::廣義圓形範圍(defType = "rectangle",actorId = "instance",
            color = "#f9d7df", duration = duration, lineWidth = 1,
            fill = true, fillColor = "#f9d7df", fillAlpha = "1-{instance.skill{instance.CSkill}CD}",
            offsetX = 25, offsetY = -35, width = 5, height = 5);
        EnhFF::廣義圓形範圍(defType = "rectangle",actorId = "instance",
            color = "#f9f1d7", duration = duration, lineWidth = 1,
            fill = true, fillColor = "#f9f1d7", fillAlpha = "1-{instance.skill{instance.VSkill}CD}",
            offsetX = 30, offsetY = -35, width = 5, height = 5);
    }
}

block 玩家死亡 {
    __repeat__ = -1;
    __label__ = "玩家";
    triggers {
        角色死亡(actor = 角色::任何玩家, varName = "instance");
    }
    actions {
            自定義::儲存Instance整數("map_x", 100);
            自定義::儲存Instance整數("map_y", 100);
            自定義::儲存Instance整數("CurrentMP", "{instance.MaxMP}");
    }
}

block 玩家初始化 {
    __repeat__ = -1;
    __label__ = "玩家";
    triggers {
        角色進入戰場(actor = 角色::任何玩家, varName = "instance");
    }
    actions {
        自定義::儲存Instance整數("STR", 0);
        自定義::儲存Instance整數("CON", 0);
        自定義::儲存Instance整數("AGI", 0);
        自定義::儲存Instance整數("INT", 0);
        自定義::儲存Instance整數("PSY", 0);
        自定義::儲存Instance整數("Level", 1);
        自定義::儲存Instance整數("Point", 2);
        自定義::儲存Instance整數("Exp", 0);
        自定義::儲存Instance整數("ExpNeeded", 100);
        自定義::儲存Instance整數("HP", 100);
        自定義::儲存Instance整數("MaxMP", 100);
        自定義::儲存Instance整數("CurrentMP", 100);
        自定義::儲存Instance整數("RegenMP", 10);
        自定義::儲存Instance整數("map_x", 100);
        自定義::儲存Instance整數("map_y", 100);
        自定義::儲存Instance整數("skill"+別名::技能治療領域EN+"CD", 0);
        自定義::儲存Instance整數("skill"+別名::技能火星領域EN+"CD", 0);
        自定義::儲存Instance整數("skill"+別名::技能震撼EN+"CD", 0);
        自定義::儲存Instance整數("skill"+別名::技能土靈召喚EN+"CD", 0);
        儲存物件變數(key = "ZSkill", object = "instance", type = "string", value = "None");
        儲存物件變數(key = "XSkill", object = "instance", type = "string", value = "None");
        儲存物件變數(key = "CSkill", object = "instance", type = "string", value = "None");
        儲存物件變數(key = "VSkill", object = "instance", type = "string", value = "None");
        取得玩家狀態(category = 狀態讀寫密鑰, key = "savedBefore", playerId = "{instance}", varName = "{instance}_savedBefore");
        人物裝備武器(actorCode = "instance", type = "fist", hand = 1);
        人物裝備武器(actorCode = "instance", type = "fist", hand = 2);
        角色說話(actorId = "instance", cleanTalk = true, text = "玩家初始中");
        設定角色屬性(actorId = "instance", attr = "group", value = "100");
        等待(duration = 500);
        自定義::儲存Instance整數("completedInit", 1);
        // 角色重生位置用作設置可走區域
        for(x in 0...2) {
            for (y in 0...2) {
                角色重生位置(actorId = "{instance}", x = x*27, y = y*27);
            }
        }
        角色重生位置(actorId = "{instance}", x = 23, y = 23);
        角色重生位置(actorId = "{instance}", x = 10, y = 10);
    }
}

block 遊戲初始化 {
    actions {
        迴避友軍攻擊();
    }
}