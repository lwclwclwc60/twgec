const 別名::武器風杖 = "custom_wind_staff";
const 別名::武器鐵劍 = "custom_iron_sword";
const 別名::武器匕首 = "custom_dagger";
const 別名::武器銀槍 = "custom_silver_spear";
const 別名::武器巨錘 = "custom_iron_hammer";
const 別名::武器土杖 = "custom_earth_staff";

def 自定義::點擊裝備武器泛型(button, weapon) : block {
    __repeat__ = -1;
    __label__ = "武器";
    triggers {
        告示牌按鈕(varName = "instance", buttonId = "wear" + button);
    }
    actions {
        人物裝備武器(actorCode = "instance", type = weapon, hand = 1);
        人物裝備武器(actorCode = "instance", type = weapon, hand = 2);
    }
}

block 點擊裝備武器風杖 = 自定義::點擊裝備武器泛型("WindStaff", 別名::武器風杖);
block 點擊裝備武器鐵劍 = 自定義::點擊裝備武器泛型("IronSword", 別名::武器鐵劍);
block 點擊裝備武器匕首 = 自定義::點擊裝備武器泛型("Dagger", 別名::武器匕首);
block 點擊裝備武器銀槍 = 自定義::點擊裝備武器泛型("SilverSpear", 別名::武器銀槍);
block 點擊裝備武器巨錘 = 自定義::點擊裝備武器泛型("IronHammer", 別名::武器巨錘);
block 點擊裝備武器土杖 = 自定義::點擊裝備武器泛型("EarthStaff", 別名::武器土杖);
block 點擊裝備武器拳頭 = 自定義::點擊裝備武器泛型("None", "fist");

def 自定義::釋放技能泛型(weapon) : block {
    __repeat__ = -1;
    __label__ = "武器";
    triggers {
        發動技能(varName = "instance", weapon = weapon);
    }
    actions {
        if(weapon == 別名::武器風杖) {
        光彈特效(fromActor = "instance", scale = "0.5", damage = 公式::風杖光彈傷害, toAngle = 公式::Instance角度 + "+32");
        光彈特效(fromActor = "instance", scale = "0.5", damage = 公式::風杖光彈傷害, toAngle = 公式::Instance角度 + "+16");
        光彈特效(fromActor = "instance", scale = "0.5", damage = 公式::風杖光彈傷害, toAngle = 公式::Instance角度);
        光彈特效(fromActor = "instance", scale = "0.5", damage = 公式::風杖光彈傷害, toAngle = 公式::Instance角度 + "-16");
        光彈特效(fromActor = "instance", scale = "0.5", damage = 公式::風杖光彈傷害, toAngle = 公式::Instance角度 + "-32");
        }
        if(weapon == 別名::武器鐵劍) {
            EnhFF::廣義圓形範圍(actorId = "instance", radius = 4*32, duration = 10000,
                color = "#D16500", deltaHpType = "heal", deltaHpValue = 公式::鐵劍技能恢復,
                deltaHpCD = 1100, deltaHpTarget = 角色::任何友軍, lineWidth = 2);
            EnhFF::廣義圓形範圍(actorId = "instance", radius = 4*32, duration = 10000,
                color = "#D16500", deltaHpType = "damage", deltaHpValue = 公式::鐵劍技能傷害,
                deltaHpCD = 1100, deltaHpTarget = 角色::任何敵軍, lineWidth = 2);
        }
        if(weapon == 別名::武器匕首) {
        EnhFF::玩家滑鼠座標(actorId = "{instance}", varX = "x", varY = "y");
        EnhFF::廣義圓形範圍(x = "{x}", y="{y}", radius = 60, duration = 500, color = "#000000", 
                deltaHpType = "damage", deltaHpValue = 公式::匕首技能傷害,
                deltaHpCD = 4000, deltaHpTarget = 角色::任何敵軍);
        移動角色位置(actorId = "{instance}", x = "{x}/32", y = "{y}/32");
        }
        if(weapon == 別名::武器銀槍) {
            EnhFF::玩家滑鼠座標(actorId = "{instance}", varX = "mouse_x", varY = "mouse_y");
            儲存全域變數(key = "spear_px", type = "number", value = "{instance.gamePosition.x}");
            儲存全域變數(key = "spear_py", type = "number", value = "{instance.gamePosition.y}");
            儲存全域變數(key = "spear_dx", type = "number", value = "{mouse_x}-{spear_px}");
            儲存全域變數(key = "spear_dy", type = "number", value = "{mouse_y}-{spear_py}");
            儲存全域變數(key = "spear_len", type = "number", value = "pow(({spear_dx}*{spear_dx}+{spear_dy}*{spear_dy}),0.5)+0.0001");
            儲存全域變數(key = "spear_nx", type = "number", value = "{spear_dx}/{spear_len}");
            儲存全域變數(key = "spear_ny", type = "number", value = "{spear_dy}/{spear_len}");
            for(i in 1...5) {
                EnhFF::廣義圓形範圍(
                x = ("{spear_px}+" + twge::to_string((i-1)*70 + 35) + "*{spear_nx}"),
                y = ("{spear_py}+" + twge::to_string((i-1)*70 + 35) + "*{spear_ny}"),
                    radius = 35, duration = 3000,
                    color = "#c7c7c7", deltaHpType = "damage", deltaHpValue = 公式::銀槍技能傷害,
                    deltaHpCD = 2000, deltaHpTarget = 角色::任何敵軍, deltaHpCasterCode = "{instance}", lineWidth = 2);
            }
        }
        if(weapon == 別名::武器巨錘) {
            儲存全域變數(key = "pos_x", type = "number", value = "{instance.gamePosition.x}");
            儲存全域變數(key = "pos_y", type = "number", value = "{instance.gamePosition.y}");
            for(i in 1...3) {
                EnhFF::廣義圓形範圍(x = "{pos_x}", y = "{pos_y}",
                    radius = 40*i, duration = 3000,
                    color = "#d38c09", deltaHpType = "damage", deltaHpValue = 公式::巨錘技能傷害,
                    deltaHpCD = 4000, deltaHpTarget = 角色::任何敵軍, deltaHpCasterCode = "{instance}", lineWidth = 2);
                等待(duration = 200);
            }
        }
        if(weapon == 別名::武器土杖) {
        EnhFF::玩家滑鼠座標(actorId = "{instance}", varX = "x", varY = "y");
        for(i in 1...8) {
            EnhFF::廣義圓形範圍(x = "{x}+random(-96,96)", y = "{y}+random(-96,96)", radius = 20, duration = 15000,
                color = "#b17302", deltaHpType = "damage", deltaHpValue = 公式::土杖石刺傷害,
                deltaHpCD = 900, deltaHpTarget = 角色::任何敵軍, deltaHpCasterCode = "{instance}", lineWidth = 2);
            }
        }
    }
}

block 釋放技能風杖 = 自定義::釋放技能泛型(別名::武器風杖);
block 釋放技能鐵劍 = 自定義::釋放技能泛型(別名::武器鐵劍);
block 釋放技能匕首 = 自定義::釋放技能泛型(別名::武器匕首);
block 釋放技能銀槍 = 自定義::釋放技能泛型(別名::武器銀槍);
block 釋放技能巨錘 = 自定義::釋放技能泛型(別名::武器巨錘);
block 釋放技能土杖 = 自定義::釋放技能泛型(別名::武器土杖);

def 自定義::武器物理攻擊泛型(weapon, value) : block  {
    __repeat__ = -1;
    __label__ = "武器";
    triggers {
        角色受傷(actor = 角色::任何, actorVarName = "instance", hitter = 角色::任何, hitterVarName = "attacker", weapon = weapon);
    }
    actions {
        角色加減血(actorCode = "instance", casterCode = "attacker", type = "流血受傷", value = value);
    }
}

block 風杖物理攻擊 = 自定義::武器物理攻擊泛型(別名::武器風杖, 公式::風杖物理傷害);
block 鐵劍物理攻擊 = 自定義::武器物理攻擊泛型(別名::武器鐵劍, 公式::鐵劍物理傷害);
block 匕首物理攻擊 = 自定義::武器物理攻擊泛型(別名::武器匕首, 公式::匕首物理傷害);
block 銀槍物理攻擊 = 自定義::武器物理攻擊泛型(別名::武器銀槍, 公式::銀槍物理傷害);
block 巨錘物理攻擊 = 自定義::武器物理攻擊泛型(別名::武器巨錘, 公式::巨錘物理傷害);
block 土杖物理攻擊 = 自定義::武器物理攻擊泛型(別名::武器土杖, 公式::土杖物理傷害);

block 風杖光彈攻擊 {
    __repeat__ = -1;
    __label__ = "武器";
    triggers {
        角色發動攻擊(weapon = 別名::武器風杖, varName = "instance");
    }
    actions {
        光彈特效(fromActor = "instance", toAngle = 公式::Instance角度, scale = "0.5", damage = 公式::風杖光彈傷害);
    }
}

block 銀槍延伸攻擊 {
    __repeat__ = -1;
    __label__ = "武器";
    triggers {
        角色發動攻擊(weapon = 別名::武器銀槍, varName = "instance");
    }
    actions {
        EnhFF::玩家滑鼠座標(actorId = "{instance}", varX = "mouse_x", varY = "mouse_y");
        儲存全域變數(key = "spear_px", type = "number", value = "{instance.gamePosition.x}");
        儲存全域變數(key = "spear_py", type = "number", value = "{instance.gamePosition.y}");
        儲存全域變數(key = "spear_dx", type = "number", value = "{mouse_x}-{spear_px}");
        儲存全域變數(key = "spear_dy", type = "number", value = "{mouse_y}-{spear_py}");
        儲存全域變數(key = "spear_len", type = "number", value = "pow(({spear_dx}*{spear_dx}+{spear_dy}*{spear_dy}),0.5)+0.0001");
        儲存全域變數(key = "spear_nx", type = "number", value = "{spear_dx}/{spear_len}");
        儲存全域變數(key = "spear_ny", type = "number", value = "{spear_dy}/{spear_len}");
        for(i in 1...4) {
            EnhFF::廣義圓形範圍(
            x = ("{spear_px}+" + twge::to_string((i-1)*50 + 25) + "*{spear_nx}"),
            y = ("{spear_py}+" + twge::to_string((i-1)*50 + 25) + "*{spear_ny}"),
                radius = 25, duration = 500,
                color = "#c7c7c7", deltaHpType = "damage", deltaHpValue = 公式::銀槍延伸傷害,
                deltaHpCD = 600, deltaHpTarget = 角色::任何敵軍, deltaHpCasterCode = "{instance}", lineWidth = 2);
            等待(duration = 100);
        }
    }
}

block 土杖石刺攻擊 {
