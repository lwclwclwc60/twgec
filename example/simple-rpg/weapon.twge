block 武器初始化 {
    __label__ = "武器";
    actions {
        設定武器技能(weapon = 別名::武器風杖);
        設定武器技能(weapon = 別名::武器鐵劍);
        設定武器技能(weapon = 別名::武器匕首);
        設定武器技能(weapon = 別名::武器銀槍);
        設定武器技能(weapon = 別名::武器巨錘);
        設定武器技能(weapon = 別名::武器土杖);
    }
}