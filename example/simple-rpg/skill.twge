const 公式::聖癒陣回復 = "2+{instance.PSY}/3";
const 公式::流火陣傷害 = "2+{instance.INT}/2+{instance.PSY}/3";
const 公式::裂地震擊傷害 = "15+{instance.CON}";
const 公式::裂地震擊範圍 = "60+10*{instance.CON}^0.5";
const 公式::土靈召喚血量 = "100+{instance.PSY}*4";
const 公式::土靈召喚傷害 = "10+{instance.PSY}/2";

const 文字::聖癒陣描述 = 
"【聖癒陣】(30MP)\n" + 
"在滑鼠指定範圍內10秒持續回復血量\n" + 
" - 回覆量: 2+精神÷3\n" +
"冷卻30秒";

const 文字::流火陣描述 = 
"【流火陣】(30MP)\n" + 
"在滑鼠指定範圍內持續出現星火\n" + 
" - 星火傷害: 2+智慧÷2+精神÷3\n" +
"冷卻10秒";

const 文字::裂地震擊描述 = 
"【裂地震擊】(25MP)\n" + 
"對自身附近的敵人造成傷害\n" +
"體質越高，威力及範圍越大\n" + 
" - 裂地震擊傷害: 15+體質\n" +
" - 裂地震擊範圍: 60+10×體質^0.5\n" +
"冷卻10秒";

const 文字::土靈召喚描述 = 
"【土靈召喚】(40MP)\n" + 
"生成一直存在35秒的土靈為你戰鬥\n" + 
" - 土靈血量: 100+精神×4\n" +
" - 土靈傷害: 10+精神÷2\n" +
"冷卻40秒";

const 別名::技能聖癒陣EN = "SanctumHeal";
const 別名::技能聖癒陣ZN = "聖癒陣";
const 別名::技能流火陣EN = "Flameflow";
const 別名::技能流火陣ZH = "流火陣";
const 別名::技能裂地震擊EN = "QuakeRift";
const 別名::技能裂地震擊ZH = "裂地震擊";
const 別名::技能土靈召喚EN = "EarthSpirit";
const 別名::技能土靈召喚ZH = "土靈召喚";

block 技能初始化 {
    __label__ = "技能";
    actions {
        儲存全域變數(key = "skill_zh_" + 別名::技能聖癒陣EN, type = "string", value = 別名::技能聖癒陣ZN);
        儲存全域變數(key = "skill_zh_" + 別名::技能流火陣EN, type = "string", value = 別名::技能流火陣ZH);
        儲存全域變數(key = "skill_zh_" + 別名::技能裂地震擊EN, type = "string", value = 別名::技能裂地震擊ZH);
        儲存全域變數(key = "skill_zh_" + 別名::技能土靈召喚EN, type = "string", value = 別名::技能土靈召喚ZH);
        儲存全域變數(key = "skill_zh_None", type = "string", value = "無");
        儲存全域變數(key = "skill_mp_" + 別名::技能聖癒陣EN, type = "int", value = 30);
        儲存全域變數(key = "skill_mp_" + 別名::技能流火陣EN, type = "int", value = 30);
        儲存全域變數(key = "skill_mp_" + 別名::技能裂地震擊EN, type = "int", value = 25);
        儲存全域變數(key = "skill_mp_" + 別名::技能土靈召喚EN, type = "int", value = 40);
        儲存全域變數(key = "skill_color_" + 別名::技能聖癒陣EN, type = "string", value = "#ffe604");
        儲存全域變數(key = "skill_color_" + 別名::技能流火陣EN, type = "string", value = "#912B2B");
        儲存全域變數(key = "skill_color_" + 別名::技能裂地震擊EN, type = "string", value = "#CC7700");
        儲存全域變數(key = "skill_color_" + 別名::技能土靈召喚EN, type = "string", value = "#A57E00");
    }
}

def 自定義::點擊設定技能泛型(keystroke, name) : block {
    __repeat__ = -1;
    __label__ = "技能";
    triggers {
        告示牌按鈕(varName = "instance", buttonId = "set" + keystroke + name);
    }
    actions {
        儲存物件變數(key = keystroke + "Skill", object = "instance", type = "string", value = name);
    }
}

