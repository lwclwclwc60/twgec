def 聖癒陣技能() : actions {
    EnhFF::玩家滑鼠座標(actorId = "{instance}", varX = "x", varY = "y");
        新增地圖音效(x = "{x}/32", y="{y}/32", resource = 音效::gettingEnergy);
    EnhFF::廣義圓形範圍(x = "{x}", y = "{y}", 
            radius = 64, duration = 10000, color = "#ffe604", 
            deltaHpType = "heal", deltaHpValue = 公式::聖癒陣回復,
            deltaHpCD = 1010, deltaHpTarget = 角色::任何友軍);
    EnhFF::廣義圓形範圍(defType = "rectangle", x = "{x}", y = "{y}", rotation = 45, 
            height = "64*pow(2,0.5)", width = "64*pow(2,0.5)", duration = 10000, color = "#ffe604");
    EnhFF::廣義圓形範圍(defType = "rectangle", x = "{x}", y = "{y}",
            height = "64", width = "1", duration = 10000, color = "#ffe604");
    EnhFF::廣義圓形範圍(defType = "rectangle", x = "{x}", y = "{y}",
            height = "1", width = "64", duration = 10000, color = "#ffe604");
    wait(duration = 30000);
}

def 流火陣技能() : actions {
    EnhFF::玩家滑鼠座標(actorId = "{instance}", varX = "x", varY = "y");
    EnhFF::廣義圓形範圍(x = "{x}", y="{y}", radius = 2*64, duration = 10000,
            color = "#912B2B", lineWidth = 3);
    for(i in 1...60) {
        wait(duration = 150);
        let random = "random(-64,64)";
        EnhFF::廣義圓形範圍(x = "{x}+"+random, y = "{y}+"+random, 
                radius = 40, duration = 500, color = "#FF0F0F", 
                deltaHpType = "damage", deltaHpValue = 公式::流火陣傷害,
                deltaHpCD = 4000, deltaHpTarget = 角色::任何敵軍);
    }
    wait(duration = 10000);
}

def 裂地震擊技能() : actions {
    新增地圖音效(actorId = "instance", resource = 音效::axeshock, volume = 2);
    EnhFF::廣義圓形範圍(actorId = "instance", 
            radius = 公式::裂地震擊範圍, duration = 2000, color = "#CC7700", 
            deltaHpType = "damage", lineWidth = 3, deltaHpValue = 公式::裂地震擊傷害,
            deltaHpCD = 4000, deltaHpTarget = 角色::任何敵軍);
    wait(duration = 12000);
}

def 土靈召喚技能() : actions {
    儲存全域變數(key = "tmp", type = "int", value = 公式::土靈召喚血量);
    新增角色(name = "土靈({tmp})", id = "earthSpirit*", camp = "第三", 
            hp = 公式::土靈召喚血量, x = 公式::InstanceX坐標, y = 公式::InstanceY坐標, localVarname = "actor", 
            weapon1 = "fist", weapon2 = "fist", teamId = 100, strength = 公式::土靈召喚傷害, role = "不動佛");
    跟隨人物(actorId = "actor", type = "跟隨人物", targetId = "{instance}");
    wait(duration = 35000);
    角色消失(actorId = "actor");
    wait(duration = 5000);
}

def 自定義::觸發技能泛型(keystroke, name) : block {
    __repeat__ = -1;
    __label__ = "技能";
    triggers {
        鍵盤按鍵(varName = "clicker", key = keystroke);
    }
    checks {
        let mp = "{skill_mp_" + name + "}";
        比對字串(matchKind = "equal", str = name, value = "{{clicker.id}."+keystroke+"Skill}");
        比較數字(lhs = "{{clicker.id}.skill"+name+"CD}", op = "!=", rhs = 1);
        比較數字(lhs = "{{clicker.id}.CurrentMP}", op = ">=", rhs = mp);
    }
    actions {
        let nameZh = "{skill_zh_" + name + "}";
        let color = "{skill_color_" + name + "}";
        let mp = "{skill_mp_" + name + "}";
        setGlobal(key = "instance", type = "string", value = "{clicker.id}");
        EnhFF::快跳文字(actorId = "{instance}", text = name, color = color, size = 18, duration = 2000);
        自定義::儲存Instance整數("skill"+name+"CD", 1);
        自定義::儲存Instance整數("CurrentMP", "{instance.CurrentMP} - " + mp);
        if(name == 別名::技能聖癒陣EN) {聖癒陣技能();}
        if(name == 別名::技能流火陣EN) {流火陣技能();}
        if(name == 別名::技能裂地震擊EN) {裂地震擊技能();}
        if(name == 別名::技能土靈召喚EN) {土靈召喚技能();}
        自定義::儲存Instance整數("skill"+name+"CD", 0);EnhFF::快跳文字(actorId = "{instance}", text = name + " is ready", color = color, size = 18, duration = 2000);
    }
}

