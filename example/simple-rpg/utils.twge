//------------------- 自定義常量 -------------------//
const 公式::Instance角度 = "{instance.bodyRotation}*180/3.14";
const 公式::Instance血量 = "98 + 10*{instance.CON} + 2*{instance.Level}";
const 公式::Instance魔量 = "98 + 8*{instance.PSY} + 5*{instance.INT} + 2*{instance.Level}";
const 公式::Instance恢復量 = "1 + {instance.PSY} + {instance.CON}/2";
const 公式::Instance魔恢復量 = "10 + {instance.PSY} + {instance.INT}/2";
const 公式::InstanceX坐標 = "{instance.gamePosition.x}/32";
const 公式::InstanceY坐標 = "{instance.gamePosition.y}/32";

const 文字::HTML等級提升 = "<span style='color: green'>Level Up</span>";

const 角色::任何 = ActorMatch();
const 角色::任何玩家 = ActorMatch(controller = "player");
const 角色::任何電腦 = ActorMatch(controller = "ai");
const 角色::任何友軍 = ActorMatch(group = 100);
const 角色::任何敵軍 = ActorMatch(group = 101);

const 出生點 = Point(10,10);
const 除錯模式 = false;
const 狀態讀寫密鑰 = "simple-rpg-test-v2";

//------------------- Metadata設定 -------------------//
__skydowLocs__ = 出生點;
__royalLocs__ = 出生點;
__thirdLocs__ = 出生點;
__lives__ = 9999;
__title__ = "RPG試驗";
__useDefaultItems__ = true;
__useCustomWeapons__ = true;
__customWeapons__ = [
    CustomWeapon(reference = "TWilightGameEventCompiler.weapon_wind_staff", code = "wind_staff", damage = 0, fireType = "單手橫劈",
    pivotOnHandDegree = 58, pivotOnHandX = 2, pivotOnHandY = 9, pivotOnHandXScale = "1.3", pivotOnHandYScale = "1.5",
    pivotOnIconDegree = -40, pivotOnIconX = 20, pivotOnIconY = 20, weight = 5),
    CustomWeapon(reference = "TWilightGameEventCompiler.weapon_iron_sword", code = "iron_sword", damage = 0, fireType = "大刀砍劈",
    pivotOnHandDegree = 35, pivotOnHandX = -12,
    pivotOnIconDegree = -40, pivotOnIconX = 27, pivotOnIconY = 14),
    CustomWeapon(reference = "TWilightGameEventCompiler.weapon_dagger", code = "dagger", damage = 0, fireType = "小刀前刺",
    pivotOnHandDegree = -92, pivotOnHandX = 34, pivotOnHandY = 24, pivotOnHandXScale = "0.7", pivotOnHandYScale = "0.8",
    pivotOnIconDegree = -140, pivotOnIconX = 34, pivotOnIconY = 16, weight = 3),
    CustomWeapon(reference = "TWilightGameEventCompiler.weapon_iron_hammer", code = "iron_hammer", damage = 0, fireType = "大刀砍劈",
    pivotOnHandDegree = -104, pivotOnHandX = 38, pivotOnHandY = 21,
    pivotOnIconDegree = -46, pivotOnIconX = 41, pivotOnIconY = 18),
    CustomWeapon(reference = "TWilightGameEventCompiler.weapon_silver_spear", code = "silver_spear", damage = 0, fireType = "雙手突刺",
    pivotOnHandDegree = -91, pivotOnHandX = 59, pivotOnHandY = 17, pivotOnHandXScale = "1.1", pivotOnHandYScale = "0.9",
    pivotOnIconDegree = -49, pivotOnIconX = 48, pivotOnIconY = 14, pivotOnIconXScale = "1.1", pivotOnIconYScale = "0.9", weight = 4),
    CustomWeapon(reference = "TWilightGameEventCompiler.weapon_earth_staff", code = "earth_staff", damage = 0, fireType = "單手橫劈",
    pivotOnHandDegree = 17, pivotOnHandX = -1, pivotOnHandY = -5, pivotOnIconDegree = -56, pivotOnIconX = 22, pivotOnIconY = 16, weight = 4)
];
__map__ = "CG.TWilightGameEventCompiler/rpg/simple_rpg.twmap";
__roomSize__ = 8;

//------------------- 自定義功能 -------------------//
def 自定義::除錯(text): actions {
    if(除錯模式) {
        print(type = "error", text = text);
    }
}

def 自定義::儲存Instance整數(key, value): actions {
    儲存物件變數(key = key, object = "instance", type = "integer", value = value);
}

def 自定義::更新角色屬性(): actions {
    自定義::儲存Instance整數("HP", 公式::Instance血量);
    設定角色屬性(actorId = "instance", attr = "maxHp", value = "{instance.HP}");
    自定義::儲存Instance整數("MaxMP", 公式::Instance魔量);
    自定義::儲存Instance整數("RegenMP", 公式::Instance魔恢復量);
    自定義::儲存Instance整數("CurrentMP", "min({instance.CurrentMP}, {instance.MaxMP})");
    設定角色屬性(actorId = "instance", attr = "closeWeaponSpeed", value = "4-3/(1+0.01*{instance.AGI})");
    設定角色屬性(actorId = "instance", attr = "weight", value = "3*pow(0.97,{instance.AGI})");
}