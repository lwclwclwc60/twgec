// OPTION: --print-ast-after --run-only=forLoopUnrolling,ifStatementPropagation,mutableVarExpansion,constantFolding

block init {
    actions {
        // Example 1: for update in same scope
        let x = 1;
        for(i in 0...5) {
            let x = x + i;
        }
        print(text = twge::to_string(x));

        // Example 2: nested for with inner scoped variable
        for(i in 0...2) {
            let n = 100;
            for(j in 0...i) {
                let n = n + j;
            }
            print(text = twge::to_string(n));
        }

        // Example 3: if true/false with outer update
        let k = 10;
        if(true) {
            let k = k + 1;
        }
        if(false) {
            let k = k + 2;
        }
        print(text = twge::to_string(k));

        // Example 4: string iteration and accumulation
        let result = "";
        for(char in "It is my string") {
            if(char == " ") {
                let result = result + "-";
            } else {
                let result = result + char;
            }
        }
        print(text = result);
    }
}
