block init {
    actions {
        print(text = twge::to_string(((((((1 + 0) + 1) + 2) + 3) + 4) + 5)));
        print(text = twge::to_string((100 + 0)));
        print(text = twge::to_string(((100 + 0) + 1)));
        print(text = twge::to_string((((100 + 0) + 1) + 2)));
        print(text = twge::to_string((10 + 1)));
        print(text = ((((((((((((((("" + "I") + "t") + "-") + "i") + "s") + "-") + "m") + "y") + "-") + "s") + "t") + "r") + "i") + "n") + "g"));
    }
}
